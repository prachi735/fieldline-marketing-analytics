            "sourceColumn": "spend_usd",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "clicks",
            "dataType": "double",
            "sourceColumn": "clicks",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "cost_per_click",
            "dataType": "double",
            "sourceColumn": "cost_per_click",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          }
        ],
        "partitions": [
          {
            "name": "channel_summary",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [#\"channel\"=text, #\"campaign_days\"=number, #\"spend_usd\"=number, #\"clicks\"=number, #\"cost_per_click\"=number], {{\"Review Sites\", 60, 7845.9000000000000000, 2130, 3.68}, {\"Display\", 60, 7544.7000000000000000, 2070, 3.64}, {\"LinkedIn Ads\", 60, 7282.5000000000000000, 2010, 3.62}, {\"Paid Search\", 60, 6942.3000000000000000, 1950, 3.56}})"
            }
