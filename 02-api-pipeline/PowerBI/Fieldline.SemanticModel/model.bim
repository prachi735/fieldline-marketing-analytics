            "summarizeBy": "none"
          },
          {
            "name": "campaign_days",
            "dataType": "double",
            "sourceColumn": "campaign_days",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "spend_usd",
