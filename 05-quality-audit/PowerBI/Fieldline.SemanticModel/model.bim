{
  "name": "Fieldline",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "reconciliation",
        "columns": [
          {
            "name": "day",
            "dataType": "string",
            "sourceColumn": "day",
            "summarizeBy": "none"
          },
          {
            "name": "ledger_usd",
            "dataType": "double",
            "sourceColumn": "ledger_usd",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "convertible_extract_usd",
            "dataType": "double",
            "sourceColumn": "convertible_extract_usd",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "variance_usd",
            "dataType": "double",
            "sourceColumn": "variance_usd",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "unpriced_rows",
            "dataType": "double",
            "sourceColumn": "unpriced_rows",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          }
        ],
        "partitions": [
          {
            "name": "reconciliation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [#\"day\"=text, #\"ledger_usd\"=number, #\"convertible_extract_usd\"=number, #\"variance_usd\"=number, #\"unpriced_rows\"=number], {{\"2025-03-01\", 1358.75, 1463.5, 104.75, 0}, {\"2025-03-02\", 1369.89, 1234.09, -135.8, 1}, {\"2025-03-03\", 1381.03, 1381.03, 0.0, 0}, {\"2025-03-04\", 1392.12, 1421.33, 29.21, 0}, {\"2025-03-05\", 1403.26, 1403.26, 0.0, 0}, {\"2025-03-06\", 1414.4, 1414.4, 0.0, 0}, {\"2025-03-07\", 1425.49, 1295.21, -130.28, 0}, {\"2025-03-08\", 1436.63, 1436.63, 0.0, 0}, {\"2025-03-09\", 1447.76, 1447.76, 0.0, 0}, {\"2025-03-10\", 1458.86, 1458.86, 0.0, 0}, {\"2025-03-11\", 1470.0, 1470.0, 0.0, 0}, {\"2025-03-12\", 1481.09, 1481.09, 0.0, 0}, {\"2025-03-13\", 1492.23, 1492.23, 0.0, 0}, {\"2025-03-14\", 1503.37, 1525.87, 22.5, 0}})"
            }
          }
        ]
      },
      {
        "name": "exceptions",
        "columns": [
          {
            "name": "day",
            "dataType": "string",
            "sourceColumn": "day",
            "summarizeBy": "none"
          },
          {
            "name": "account",
