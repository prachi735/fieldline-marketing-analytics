            "sourceColumn": "campaign",
            "summarizeBy": "none"
          },
          {
            "name": "rule",
            "dataType": "string",
            "sourceColumn": "rule",
            "summarizeBy": "none"
          },
          {
            "name": "severity",
            "dataType": "string",
            "sourceColumn": "severity",
            "summarizeBy": "none"
          },
          {
            "name": "evidence",
            "dataType": "string",
            "sourceColumn": "evidence",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "exceptions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [#\"day\"=text, #\"account\"=text, #\"campaign\"=text, #\"rule\"=text, #\"severity\"=text, #\"evidence\"=text], {{\"2025-03-02\", \"A3\", \"P3\", \"Currency\", \"High\", \"EURO\"}, {\"2025-03-01\", \"A1\", \"P4\", \"Duplicate key\", \"High\", \"2 rows per key\"}, {\"2025-03-14\", \"A9\", \"P1\", \"Extra key\", \"High\", \"Extract key absent in source\"}, {\"2025-03-01\", \"A3\", \"P4\", \"Missing field\", \"High\", \"Channel is empty\"}, {\"2025-03-07\", \"A3\", \"P1\", \"Missing key\", \"High\", \"Source key absent in extract\"}, {\"2025-03-02\", \"A3\", \"P3\", \"Spend mismatch\", \"High\", \"Extract EURO 10693 vs source GBP 10693 (minor units)\"}, {\"2025-03-04\", \"A3\", \"P3\", \"Spend mismatch\", \"High\", \"Extract GBP 13159 vs source GBP 10859 (minor units)\"}, {\"2025-03-04\", \"A3\", \"P3\", \"CPC mismatch\", \"Medium\", \"Reported 4.93 vs computed 5.97\"}, {\"2025-03-04\", \"A3\", \"P4\", \"CPC mismatch\", \"Medium\", \"Reported 6.19 vs computed 4.94\"}, {\"2025-03-07\", \"A1\", \"P4\", \"CPC mismatch\", \"Medium\", \"Reported 3.14 vs computed 2.81\"}, {\"2025-03-07\", \"A1\", \"P4\", \"Clicks mismatch\", \"Medium\", \"39 clicks vs source 35\"}, {\"2025-03-06\", \"A2\", \"P1\", \"Late load\", \"Medium\", \"Arrived on 2025-03-15\"}, {\"2025-03-04\", \"A1\", \"P2\", \"Taxonomy\", \"Medium\", \"Paid_Srch\"}})"
            }
          }
        ]
      },
      {
        "name": "scorecard",
        "columns": [
          {
            "name": "rule",
            "dataType": "string",
            "sourceColumn": "rule",
            "summarizeBy": "none"
          },
          {
            "name": "owner",
            "dataType": "string",
            "sourceColumn": "owner",
            "summarizeBy": "none"
          },
          {
            "name": "action",
            "dataType": "string",
            "sourceColumn": "action",
            "summarizeBy": "none"
          },
          {
            "name": "exceptions",
            "dataType": "double",
            "sourceColumn": "exceptions",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          }
        ],
        "partitions": [
          {
            "name": "scorecard",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [#\"rule\"=text, #\"owner\"=text, #\"action\"=text, #\"exceptions\"=number], {{\"CPC mismatch\", \"Analytics\", \"Recompute cost per click after upstream corrections.\", 3}, {\"Spend mismatch\", \"Finance analytics\", \"Compare native amounts against the source ledger.\", 2}, {\"Clicks mismatch\", \"Marketing ops\", \"Re-export click totals for this campaign-day.\", 1}, {\"Currency\", \"Finance analytics\", \"Quarantine the unmapped currency and confirm its ISO code.\", 1}, {\"Duplicate key\", \"Data engineering\", \"Deduplicate by campaign-day before loading.\", 1}, {\"Extra key\", \"Data engineering\", \"Trace the unexpected account and quarantine its row.\", 1}, {\"Late load\", \"Data engineering\", \"Investigate ingestion latency and backfill the partition.\", 1}, {\"Missing field\", \"Data engineering\", \"Restore the source channel before publication.\", 1}, {\"Missing key\", \"Data engineering\", \"Replay the missing source key.\", 1}, {\"Taxonomy\", \"Marketing ops\", \"Map the source label to the approved channel list.\", 1}})"
            }
          }
        ]
      }
    ]
  }
